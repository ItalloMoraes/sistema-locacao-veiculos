
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int       @id @default(autoincrement())
  nome         String
  email        String    @unique
  senha        String
  dataCadastro DateTime  @default(now())

  locacoes     Locacao[]
}

model Veiculo {
  id             Int       @id @default(autoincrement())
  marca          String
  modelo         String
  placa          String    @unique
  ano            Int
  diaria         Decimal   @db.Decimal(10, 2)
  disponibilidade Boolean @default(true)

  locacoes       Locacao[]
}

model Locacao {
  id                    Int       @id @default(autoincrement())
  usuarioId             Int
  veiculoId             Int
  dataInicio            DateTime  @default(now())
  dataPrevisaoDevolucao DateTime
  dataDevolucao         DateTime?
  valorTotal            Decimal   @db.Decimal(10, 2)
  status                String    @default("ATIVA")

  usuario               Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  veiculo               Veiculo   @relation(fields: [veiculoId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@index([veiculoId])
  @@index([status])
}
